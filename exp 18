import threading
import time
import random
BUFFER_SIZE = 5
buffer = []
empty = threading.Semaphore(BUFFER_SIZE)
full = threading.Semaphore(0)
mutex = threading.Semaphore(1)
def producer():
    for i in range(10):
        item = random.randint(1, 100)
        empty.acquire()
        mutex.acquire()
        buffer.append(item)
        print("Produced:", item)
        print("Buffer:", buffer)
        mutex.release()
        full.release()
        time.sleep(1)
def consumer():
    for i in range(10):
        full.acquire()
        mutex.acquire()
        item = buffer.pop(0)
        print("Consumed:", item)
        print("Buffer:", buffer)
        mutex.release()
        empty.release()
        time.sleep(1)
t1 = threading.Thread(target=producer)
t2 = threading.Thread(target=consumer)
t1.start()
t2.start()
t1.join()
t2.join()
print("Producer-Consumer execution completed")
