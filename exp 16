import os
filename = "employee.dat"
def add_employee():
    file = open(filename, "a")
    emp_id = input("Enter Employee ID: ")
    name = input("Enter Employee Name: ")
    salary = input("Enter Salary: ")
    record = emp_id + "," + name + "," + salary + "\n"
    file.write(record)
    file.close()
    print("Employee record added successfully!\n")
def search_employee():
    emp_search = input("Enter Employee ID to search: ")
    found = False
    file = open(filename, "r")
    for line in file:
        emp_id, name, salary = line.strip().split(",")
        if emp_id == emp_search:
            print("\nEmployee Found")
            print("Employee ID :", emp_id)
            print("Employee Name :", name)
            print("Salary :", salary)
            found = True
            break
    file.close()
    if not found:
        print("Employee record not found")
while True:
    print("\n----- Employee File Processing -----")
    print("1. Add Employee")
    print("2. Search Employee")
    print("3. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        add_employee()
    elif choice == "2":
        search_employee()
    elif choice == "3":
        print("Program Ended")
        break
    else:
        print("Invalid Choice")
